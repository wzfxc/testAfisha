# Server-only backend URL (NEVER prefixed with NEXT_PUBLIC_)
API_URL=http://localhost:4000

# Timeout in milliseconds for server-side requests to the backend API
API_TIMEOUT_MS=5000

# Shared secret sent in `x-internal-secret` header during SSR/SSG to authenticate proxy requests.
# Required in production (or provide INTERNAL_SECRET_FILE).
# Generate locally with: openssl rand -base64 32
INTERNAL_SECRET=
