NODE_ENV=development
PORT=4000

# Secret shared with the Next.js server. Requests carrying it in the
# `x-internal-secret` header bypass the rate limiter. Unset = bypass disabled.
INTERNAL_SECRET=change-me-to-a-long-random-string

# Rate limit per client IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Number of reverse-proxy hops to trust for req.ip (0 = none)
TRUST_PROXY_HOPS=0

# Comma-separated list of allowed browser origins (empty = CORS disabled)
CORS_ORIGINS=http://localhost:3000

# Promise cache
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=500

# Simulated DB latency (ms)
DB_MIN_DELAY_MS=300
DB_MAX_DELAY_MS=800

# Max time to wait for in-flight requests after SIGTERM
SHUTDOWN_TIMEOUT_MS=10000

# Runtime writable JSON path (seeded from events.seed.json if absent)
DATA_FILE=data/events.json

