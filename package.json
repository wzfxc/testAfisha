{
  "name": "afisha-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "build:shared": "pnpm --filter @app/shared build",
    "build:api": "pnpm --filter @app/shared build && pnpm --filter @app/api build",
    "build:web": "pnpm --filter @app/shared build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @app/api test"
  }
}
