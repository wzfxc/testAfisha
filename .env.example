# Copy to .env when customizing settings locally or for Docker Compose.
# Notice: INTERNAL_SECRET is auto-generated by Docker Compose (`secret-init` service)
# into a shared read-only secret volume. For local non-Docker runs, generate one via:
#   openssl rand -base64 32
INTERNAL_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CACHE_TTL_MS=60000
CACHE_MAX_ENTRIES=500
DB_MIN_DELAY_MS=300
DB_MAX_DELAY_MS=800
API_TIMEOUT_MS=5000
