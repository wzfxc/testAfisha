{
  "name": "@app/api",
  "version": "1.0.0",
  "private": true,
  "description": "Events (afisha) REST API: promise cache, rate limiting, graceful shutdown",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "generate:data": "node scripts/generate-events.mjs",
    "test": "tsx --test tests/api.test.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
